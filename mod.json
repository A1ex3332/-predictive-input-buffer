{
  "geode": "5.11.2",
  "gd": {
    "win": "*",
    "android": "*",
    "mac": "*",
    "ios": "*"
  },
  "id": "yourname.predictive_input_buffer",
  "name": "Predictive Input Buffer",
  "version": "v1.0.0",
  "developer": "yourname",
  "description": "Practice-mode predictive input buffer. F6 cycles stages.",
  "settings": {
    "lookahead": {
      "type": "int",
      "default": 120,
      "min": 10,
      "max": 480,
      "name": "Lookahead (ticks)"
    },
    "wave-lookahead": {
      "type": "int",
      "default": 90,
      "min": 10,
      "max": 480,
      "name": "Wave lookahead (ticks)"
    },
    "safety-margin": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2,
      "name": "Safety margin (ticks)"
    },
    "delay-offset": {
      "type": "int",
      "default": 0,
      "min": -2,
      "max": 2,
      "name": "Delay offset (ticks)"
    },
    "fix-releases": {
      "type": "bool",
      "default": true,
      "name": "Also fix releases (ship / wave)"
    },
    "debug": {
      "type": "bool",
      "default": true,
      "name": "Debug log"
    }
  }
}
