{
  "geode": "5.11.2",
  "gd": {
    "win": "*",
    "android": "*",
    "mac": "*",
    "ios": "*"
  },
  "id": "yourname.predictive_input_buffer",
  "name": "Predictive Input Buffer",
  "version": "v1.0.0",
  "developer": "yourname",
  "description": "Practice-mode predictive input buffer. F6 cycles stages.",
  "settings": {
    "lookahead": {
      "type": "int",
      "default": 40,
      "min": 10,
      "max": 240,
      "name": "Lookahead (ticks)"
    },
    "wave-lookahead": {
      "type": "int",
      "default": 30,
      "min": 10,
      "max": 240,
      "name": "Wave lookahead (ticks)"
    },
    "debug": {
      "type": "bool",
      "default": true,
      "name": "Debug log"
    }
  }
}
